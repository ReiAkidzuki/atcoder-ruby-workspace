#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$project_root"
source "$project_root/bin/platform"
unset RUBYGEMS_GEMDEPS

ruby_version="$(tr -d '[:space:]' < .ruby-version)"
bundle_command=(rbenv exec bundle _2.6.9_)

install_linux_packages() {
  local -a privilege
  local -a packages

  if ! command -v apt-get >/dev/null 2>&1; then
    echo "error: apt-get is required for automatic Linux dependency setup" >&2
    exit 1
  fi

  privilege=()
  if [[ "$EUID" -ne 0 ]]; then
    if ! command -v sudo >/dev/null 2>&1; then
      echo "error: sudo is required to install Linux dependencies" >&2
      exit 1
    fi
    privilege=(sudo)
  fi

  packages=(
    autoconf
    bison
    build-essential
    cmake
    curl
    gfortran
    libdb-dev
    libffi-dev
    libgdbm-dev
    libgeos-dev
    libgmp-dev
    libncurses-dev
    libopenblas0
    libreadline-dev
    libssl-dev
    libyaml-dev
    libz3-dev
    patch
    rustc
    time
    unzip
    uuid-dev
    zlib1g-dev
  )

  echo "Installing native dependencies with apt..."
  "${privilege[@]}" apt-get update
  "${privilege[@]}" apt-get install -y "${packages[@]}"
}

install_native_dependencies() {
  case "$(atcoder_os_name)" in
    Darwin)
      if ! command -v brew >/dev/null 2>&1; then
        echo "error: Homebrew is required on macOS" >&2
        exit 1
      fi

      echo "Installing native dependencies from Brewfile..."
      brew bundle --no-upgrade --file="$project_root/Brewfile"
      ;;
    Linux)
      install_linux_packages
      ;;
    *)
      echo "error: unsupported operating system: $(atcoder_os_name)" >&2
      exit 1
      ;;
  esac
}

install_libtorch() {
  local archive
  local archive_download
  local actual_sha256
  local libtorch_parent
  local libtorch_sha256
  local libtorch_url
  local marker
  local platform

  platform="$(atcoder_os_name)-$(atcoder_arch_name)"
  libtorch_parent="$project_root/.cache/libtorch/$ATCODER_LIBTORCH_VERSION/$platform"
  LIBTORCH_DIR="$libtorch_parent/libtorch"
  archive="$libtorch_parent/libtorch.zip"
  archive_download="$libtorch_parent/libtorch.zip.download"
  marker="$libtorch_parent/.archive-sha256"
  libtorch_sha256="$(atcoder_libtorch_sha256)"

  if [[ -f "$LIBTORCH_DIR/include/torch/extension.h" ]] &&
     find "$LIBTORCH_DIR/lib" -maxdepth 1 -name '*torch_cpu*' -print -quit |
       grep -q . &&
     [[ -f "$marker" ]] &&
     [[ "$(tr -d '[:space:]' < "$marker")" == "$libtorch_sha256" ]]; then
    echo "Using cached LibTorch ${ATCODER_LIBTORCH_VERSION}: $LIBTORCH_DIR"
    return
  fi

  libtorch_url="$(atcoder_libtorch_url)"
  mkdir -p "$libtorch_parent"

  actual_sha256=""
  if [[ -f "$archive" ]]; then
    actual_sha256="$(atcoder_sha256_file "$archive")"
  fi
  if [[ "$actual_sha256" != "$libtorch_sha256" ]]; then
    echo "Downloading LibTorch ${ATCODER_LIBTORCH_VERSION}..."
    curl --fail --location --retry 3 --output "$archive_download" "$libtorch_url"
    actual_sha256="$(atcoder_sha256_file "$archive_download")"
    if [[ "$actual_sha256" != "$libtorch_sha256" ]]; then
      echo "error: LibTorch archive SHA-256 mismatch" >&2
      echo "expected: $libtorch_sha256" >&2
      echo "actual:   $actual_sha256" >&2
      exit 1
    fi
    mv "$archive_download" "$archive"
  fi

  printf '' > "$marker"
  unzip -q -o "$archive" -d "$libtorch_parent"

  if [[ ! -f "$LIBTORCH_DIR/include/torch/extension.h" ]] ||
     ! find "$LIBTORCH_DIR/lib" -maxdepth 1 -name '*torch_cpu*' -print -quit |
       grep -q .; then
    echo "error: downloaded LibTorch archive has an unexpected layout" >&2
    exit 1
  fi
  printf '%s\n' "$libtorch_sha256" > "$marker"
}

if ! command -v rbenv >/dev/null 2>&1; then
  echo "error: rbenv is required" >&2
  exit 1
fi

if ! command -v uv >/dev/null 2>&1; then
  echo "error: uv is required (https://docs.astral.sh/uv/)" >&2
  exit 1
fi

install_native_dependencies

if ! gnu_time="$(atcoder_gnu_time_command)"; then
  echo "error: GNU time is unavailable after dependency setup" >&2
  exit 1
fi

echo "Installing Ruby ${ruby_version} with rbenv..."
rbenv install -s "$ruby_version"
export RBENV_VERSION="$ruby_version"

install_libtorch

if command -v nproc >/dev/null 2>&1; then
  available_jobs="$(nproc)"
else
  available_jobs="$(sysctl -n hw.logicalcpu)"
fi
build_jobs="${ATCODER_BUILD_JOBS:-2}"
if [[ ! "$build_jobs" =~ ^[1-9][0-9]*$ ]]; then
  echo "error: ATCODER_BUILD_JOBS must be a positive integer" >&2
  exit 1
fi
if (( build_jobs > available_jobs )); then
  build_jobs="$available_jobs"
fi

echo "Installing AtCoder Ruby gems from Gemfile.lock..."
"${bundle_command[@]}" config set --local path "$project_root/.bundle/gems"
"${bundle_command[@]}" config set --local clean true
"${bundle_command[@]}" config set --local disable_shared_gems true
"${bundle_command[@]}" config set --local \
  build.torch-rb "--with-torch-dir=$LIBTORCH_DIR"
gem_api="$(rbenv exec ruby -rrbconfig -e \
  'print RbConfig::CONFIG.fetch("ruby_version")')"
gem_home="$project_root/.bundle/gems/ruby/$gem_api"
workspace_marker="$project_root/.bundle/workspace-path"
rebuild_path_dependent_gems=false
if atcoder_workspace_moved \
  "$workspace_marker" "$project_root" "$gem_home" "$LIBTORCH_DIR"; then
  rebuild_path_dependent_gems=true
fi
if [[ "$rebuild_path_dependent_gems" == true ]]; then
  echo "Workspace path changed; path-dependent native gems will be rebuilt."
fi

MAKEFLAGS="-j${build_jobs}" BUNDLE_FROZEN=true \
  "${bundle_command[@]}" install --jobs 1 --retry 3
if [[ "$rebuild_path_dependent_gems" == true ]]; then
  MAKEFLAGS="-j${build_jobs}" BUNDLE_FROZEN=true \
    "${bundle_command[@]}" pristine numo-openblas torch-rb
fi
printf '%s\n' "$project_root" > "$workspace_marker"

export UV_CACHE_DIR="$project_root/.cache/uv"
echo "Installing oj and aclogin into .venv..."
uv sync --locked --python 3.10

echo
"$project_root/bin/doctor"
